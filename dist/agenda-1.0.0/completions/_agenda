#compdef agenda

__agenda_complete() {
    local -ar non_empty_completions=("${@:#(|:*)}")
    local -ar empty_completions=("${(M)@:#(|:*)}")
    _describe -V '' non_empty_completions -- empty_completions -P $'\'\''
}

__agenda_custom_complete() {
    local -a completions
    completions=("${(@f)"$("${command_name}" "${@}" "${command_line[@]}")"}")
    if [[ "${#completions[@]}" -gt 1 ]]; then
        __agenda_complete "${completions[@]:0:-1}"
    fi
}

__agenda_cursor_index_in_current_word() {
    if [[ -z "${QIPREFIX}${IPREFIX}${PREFIX}" ]]; then
        printf 0
    else
        printf %s "${#${(z)LBUFFER}[-1]}"
    fi
}

_agenda() {
    emulate -RL zsh -G
    setopt extendedglob nullglob numericglobsort
    unsetopt aliases banghist

    local -xr SAP_SHELL=zsh
    local -x SAP_SHELL_VERSION
    SAP_SHELL_VERSION="$(builtin emulate zsh -c 'printf %s "${ZSH_VERSION}"')"
    local -r SAP_SHELL_VERSION

    local context state state_descr line
    local -A opt_args

    local -r command_name="${words[1]}"
    local -ar command_line=("${words[@]}")
    local -ir current_word_index="$((CURRENT - 1))"

    local -i ret=1
    local -ar arg_specs=(
        '--version[Show the version.]'
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0
    case "${state}" in
    command)
        local -ar subcommands=(
            'events:List calendar events.'
            'today:Everything on today — events, plus reminders due.'
            'tomorrow:Everything on tomorrow — events, plus reminders due.'
            'reminders:List reminders.'
            'search:Find events and reminders matching some text.'
            'free:Find gaps long enough to schedule something.'
            'add:Create an event, or a reminder with --remind.'
            'done:Mark a reminder complete.'
            'edit:Change an existing reminder.'
            'move:Reschedule or edit an existing event.'
            'delete:Delete an event or reminder by id.'
            'calendars:List calendars, or reminder lists with --reminders.'
            'doctor:Check calendar and reminder permissions.'
            'describe:Describe this tool'\''s commands in machine-readable form.'
            'mcp:Serve calendar and reminder tools over MCP (stdio).'
            'help:Show subcommand help information.'
        )
        _describe -V subcommand subcommands && ret=0
        ;;
    arg)
        case "${words[1]}" in
        events|today|tomorrow|reminders|search|free|add|done|edit|move|delete|calendars|doctor|describe|mcp|help)
            "_agenda_${words[1]}" && ret=0
            ;;
        esac
        ;;
    esac

    return "${ret}"
}

